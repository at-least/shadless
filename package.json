{
  "name": "shadless",
  "version": "1.0.0",
  "description": "React-free shadcn/ui components \u2014 HTML + Tailwind CSS + vanilla JS, mechanically converted from the pinned shadcn registry",
  "license": "MIT",
  "author": "newlix",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "dist/js/*.js",
    "dist/esm/*.mjs",
    "dist/shadless.js",
    "dist/shadless.min.js",
    "**/*.css"
  ],
  "style": "./dist/shadless.full.css",
  "exports": {
    ".": "./dist/shadless-core.css",
    "./full.css": "./dist/shadless.full.css",
    "./full.min.css": "./dist/shadless.full.min.css",
    "./css/*": "./dist/css/*.css",
    "./*": "./dist/css/*",
    "./runtime": {
      "types": "./dist/esm/shadless.d.ts",
      "import": "./dist/esm/shadless.mjs",
      "default": "./dist/shadless.js"
    },
    "./runtime.min": {
      "types": "./dist/esm/shadless.d.ts",
      "import": "./dist/esm/shadless.min.mjs",
      "default": "./dist/shadless.min.js"
    },
    "./esm/*": "./dist/esm/*.mjs",
    "./package.json": "./package.json",
    "./css": "./dist/shadless-core.css",
    "./js/*": {
      "types": "./dist/esm/*.d.ts",
      "import": "./dist/esm/*.mjs",
      "default": "./dist/js/*.js"
    }
  },
  "files": [
    "dist/css/",
    "dist/js/",
    "dist/esm/",
    "dist/shadless-core.css",
    "dist/shadless.full.css",
    "dist/shadless.full.min.css",
    "dist/shadless.js",
    "dist/shadless.min.js"
  ],
  "scripts": {
    "pipeline": "cd pipeline && go build -o ../build/pipeline .",
    "pin": "npm run pipeline && ./build/pipeline pin",
    "unit": "node tools/unit-check.mjs",
    "contracts": "node tools/contracts/run.mjs",
    "convert": "node tools/resolve-skins.mjs && node src/converter/index.mjs",
    "emit": "npm run pipeline && node src/emitter/index.mjs && ./build/pipeline tw build/emit/globals.css build/emit/out.css --cwd dist && node src/emitter/smoke.mjs",
    "demo": "npm run emit && node tools/build-demo.mjs && node tools/example-oracle.mjs && node tools/example-fixture.mjs && node tools/build-rtl.mjs && node tools/demo.mjs && ./build/pipeline product-css && ./build/pipeline tw dist/globals.css dist/out.css --cwd . && ./build/pipeline tw dist/shadless.product.css dist/shadless.full.css && ./build/pipeline tw dist/shadless.product.css dist/shadless.full.min.css --minify",
    "demo:smoke": "node tools/demo-smoke.mjs",
    "verify": "npm run pipeline && ./build/pipeline run all",
    "gate:direction": "node tools/css-direction-gate.mjs",
    "docs": "npm run pipeline && node tools/build-demo.mjs && node tools/build-rtl.mjs && ./build/pipeline docs-catalog && node tools/docs-build.mjs",
    "docs:verify": "npm run docs && npm run docs:links && node tools/docs-consistency.mjs && node tools/docs-fidelity.mjs && node tools/docs-smoke.mjs --all",
    "docs:links": "node tools/docs-links.mjs",
    "docs:consistency": "node tools/docs-consistency.mjs",
    "docs:fidelity": "node tools/docs-fidelity.mjs",
    "docs:smoke": "node tools/docs-smoke.mjs",
    "probe:h1": "node probes/h1-decompose.mjs",
    "probe:h1b": "node probes/h1b-bounded-logic.mjs",
    "probe:h2": "node probes/h2-contract-surface.mjs",
    "probe:h3": "node probes/h3-kernel-gap.mjs",
    "probe:h3b": "node probes/h3b-primitives.mjs",
    "probe:h5": "node probes/h5-tiers.mjs && node probes/h5-shadcn-oracle.mjs",
    "probe:h4": "node probes/h4/convert.mjs && node probes/h4/mkglobals.mjs && npx @tailwindcss/cli -i probes/h4/globals.css -o probes/h4/out.css && node probes/h4/assert.mjs",
    "probe:t3": "node probes/t3/mk.mjs && npx @tailwindcss/cli -i probes/t3/globals-a.css -o probes/t3/out-a.css && npx @tailwindcss/cli -i probes/t3/globals-b.css -o probes/t3/out-b.css && node probes/t3/shoot.mjs",
    "verify:fast": "npm run pipeline && ./build/pipeline run fast",
    "verify:medium": "npm run pipeline && ./build/pipeline run medium",
    "gates": "npm run pipeline && ./build/pipeline list all",
    "meta": "SHADLESS_META=1 go test -C pipeline -count=1 -v -timeout 2h -run '^TestMeta$' .",
    "overlay": "node gates/overlay.mjs --audit",
    "ledger": "go test -C pipeline -count=1 -v -run '^TestLedger$' .",
    "gate:path": "node gates/path-parity.mjs",
    "test": "npm run pipeline && ./build/pipeline run fast",
    "gate:pack": "go test -C pipeline -count=1 -v -run '^TestPack$' ."
  },
  "keywords": [
    "shadcn",
    "shadcn/ui",
    "tailwindcss",
    "components",
    "vanilla",
    "no-react"
  ],
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@mdx-js/mdx": "^3.1.1",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/cli": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.474.0",
    "playwright": "^1.62.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@radix-ui/primitive": "1.1.3",
    "@radix-ui/react-accessible-icon": "1.1.7",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-arrow": "1.1.7",
    "@radix-ui/react-aspect-ratio": "1.1.7",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-collection": "1.1.7",
    "@radix-ui/react-compose-refs": "1.1.2",
    "@radix-ui/react-context": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-direction": "1.1.1",
    "@radix-ui/react-dismissable-layer": "1.1.11",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-focus-guards": "1.1.3",
    "@radix-ui/react-focus-scope": "1.1.7",
    "@radix-ui/react-form": "0.1.8",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-menu": "2.1.16",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-one-time-password-field": "0.1.8",
    "@radix-ui/react-password-toggle-field": "0.1.3",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-popper": "1.2.8",
    "@radix-ui/react-portal": "1.1.9",
    "@radix-ui/react-presence": "1.1.5",
    "@radix-ui/react-primitive": "2.1.3",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-roving-focus": "1.1.11",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-toolbar": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@radix-ui/react-use-callback-ref": "1.1.1",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@radix-ui/react-use-effect-event": "0.0.2",
    "@radix-ui/react-use-escape-keydown": "1.1.1",
    "@radix-ui/react-use-is-hydrated": "0.1.0",
    "@radix-ui/react-use-layout-effect": "1.1.1",
    "@radix-ui/react-use-size": "1.1.1",
    "@radix-ui/react-visually-hidden": "1.2.3"
  }
}
