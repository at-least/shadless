{
  "name": "shadless",
  "version": "1.0.0",
  "description": "React-free shadcn/ui components — HTML + Tailwind CSS + vanilla JS, mechanically converted from the pinned shadcn registry",
  "license": "MIT",
  "author": "newlix",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "dist/js/*.js",
    "dist/esm/*.mjs",
    "dist/shadless.js",
    "dist/shadless.min.js",
    "**/*.css"
  ],
  "style": "./dist/shadless.full.css",
  "exports": {
    ".": "./dist/shadless-core.css",
    "./full.css": "./dist/shadless.full.css",
    "./full.min.css": "./dist/shadless.full.min.css",
    "./css/*": "./dist/css/*.css",
    "./*": "./dist/css/*",
    "./runtime": {
      "types": "./dist/esm/shadless.d.ts",
      "import": "./dist/esm/shadless.mjs",
      "default": "./dist/shadless.js"
    },
    "./runtime.min": {
      "types": "./dist/esm/shadless.d.ts",
      "import": "./dist/esm/shadless.min.mjs",
      "default": "./dist/shadless.min.js"
    },
    "./esm/*": "./dist/esm/*.mjs",
    "./package.json": "./package.json",
    "./css": "./dist/shadless-core.css",
    "./js/*": {
      "types": "./dist/esm/*.d.ts",
      "import": "./dist/esm/*.mjs",
      "default": "./dist/js/*.js"
    }
  },
  "files": [
    "dist/css/",
    "dist/js/",
    "dist/esm/",
    "dist/shadless-core.css",
    "dist/shadless.full.css",
    "dist/shadless.full.min.css",
    "dist/shadless.js",
    "dist/shadless.min.js"
  ],
  "scripts": {
    "pin": "node tools/pin.mjs",
    "unit": "node tools/unit-check.mjs",
    "contracts": "node tools/contracts/run.mjs",
    "convert": "node tools/resolve-skins.mjs && node src/converter/index.mjs",
    "emit": "node src/emitter/index.mjs && node tools/tw.mjs build/emit/globals.css build/emit/out.css --cwd dist && node src/emitter/smoke.mjs",
    "demo": "npm run emit && node tools/build-demo.mjs && node tools/example-oracle.mjs && node tools/example-fixture.mjs && node tools/build-rtl.mjs && node tools/demo.mjs && node tools/product-css.mjs && node tools/tw.mjs dist/globals.css dist/out.css --cwd . && node tools/tw.mjs dist/shadless.product.css dist/shadless.full.css && node tools/tw.mjs dist/shadless.product.css dist/shadless.full.min.css --minify",
    "demo:smoke": "node tools/demo-smoke.mjs",
    "verify": "node gates/run.mjs --tier=full",
    "gate:direction": "node tools/css-direction-gate.mjs",
    "docs": "node tools/build-demo.mjs && node tools/build-rtl.mjs && node tools/docs-catalog.mjs && node tools/docs-build.mjs",
    "docs:verify": "npm run docs && npm run docs:links && node tools/docs-consistency.mjs && node tools/docs-fidelity.mjs && node tools/docs-smoke.mjs --all",
    "docs:links": "node tools/docs-links.mjs",
    "docs:consistency": "node tools/docs-consistency.mjs",
    "docs:fidelity": "node tools/docs-fidelity.mjs",
    "docs:smoke": "node tools/docs-smoke.mjs",
    "probe:h1": "node probes/h1-decompose.mjs",
    "probe:h1b": "node probes/h1b-bounded-logic.mjs",
    "probe:h2": "node probes/h2-contract-surface.mjs",
    "probe:h3": "node probes/h3-kernel-gap.mjs",
    "probe:h3b": "node probes/h3b-primitives.mjs",
    "probe:h5": "node probes/h5-tiers.mjs && node probes/h5-shadcn-oracle.mjs",
    "probe:h4": "node probes/h4/convert.mjs && node probes/h4/mkglobals.mjs && npx @tailwindcss/cli -i probes/h4/globals.css -o probes/h4/out.css && node probes/h4/assert.mjs",
    "probe:t3": "node probes/t3/mk.mjs && npx @tailwindcss/cli -i probes/t3/globals-a.css -o probes/t3/out-a.css && npx @tailwindcss/cli -i probes/t3/globals-b.css -o probes/t3/out-b.css && node probes/t3/shoot.mjs",
    "verify:fast": "node gates/run.mjs --tier=fast",
    "verify:medium": "node gates/run.mjs --tier=medium",
    "gates": "node gates/run.mjs --list --tier=full",
    "meta": "node gates/meta.mjs",
    "overlay": "node gates/overlay.mjs --audit",
    "ledger": "node gates/ledger.mjs --verify",
    "gate:path": "node gates/path-parity.mjs",
    "test": "node gates/run.mjs --tier=fast",
    "gate:pack": "node gates/pack.mjs",
    "w:pin": "wireit",
    "w:unit": "wireit",
    "w:ledger": "wireit",
    "w:wireit-sync": "wireit",
    "w:dist-complete": "wireit",
    "w:pack": "wireit",
    "w:coverage": "wireit",
    "w:overlay": "wireit",
    "w:convert": "wireit",
    "w:emit": "wireit",
    "w:emit-smoke": "wireit",
    "w:build-js": "wireit",
    "w:contract-fixture": "wireit",
    "w:demo-build": "wireit",
    "w:example-oracle": "wireit",
    "w:example-fixture": "wireit",
    "w:demo-rtl": "wireit",
    "w:demo": "wireit",
    "w:product-css": "wireit",
    "w:demo-css": "wireit",
    "w:product-build": "wireit",
    "w:product-verify": "wireit",
    "w:consumer-sim": "wireit",
    "w:path-parity": "wireit",
    "w:demo-parity": "wireit",
    "w:css-direction": "wireit",
    "w:contracts": "wireit",
    "w:oracle-css": "wireit",
    "w:style-parity": "wireit",
    "w:demo-smoke": "wireit",
    "w:docs-catalog": "wireit",
    "w:docs-build": "wireit",
    "w:docs-links": "wireit",
    "w:docs-consistency": "wireit",
    "w:docs-fidelity": "wireit",
    "w:docs-smoke": "wireit",
    "w:docs-upstream": "wireit",
    "w:interactivity-sweep": "wireit",
    "w:reproducible": "wireit",
    "w:golden-gate": "wireit",
    "w:example-gate": "wireit",
    "w:fast": "wireit",
    "w:medium": "wireit",
    "w:full": "wireit",
    "w:builds": "wireit"
  },
  "keywords": [
    "shadcn",
    "shadcn/ui",
    "tailwindcss",
    "components",
    "vanilla",
    "no-react"
  ],
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
