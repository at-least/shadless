      "text": ""
    },
    "scroll-area-thumb": {
      "tag": "div",
      "data-state": "visible",
      "data-slot": "scroll-area-thumb",
      "style": "width: var(--radix-scroll-area-thumb-width); height: var(--radix-scroll-area-thumb-height); transform: translate3d(0px, 0px, 0px);",
      "text": ""
    },
    "activeElement": "body",
    "scrollLock": {
      "attr": null,
      "pointerEvents": ""
    }
  },
