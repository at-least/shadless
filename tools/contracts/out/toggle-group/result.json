      "tabindex": "0",
      "style": "outline: none; --gap: 2;",
      "text": "AB"
    },
    "toggle-group-item": {
      "tag": "button",
      "type": "button",
      "data-state": "off",
      "role": "radio",
      "aria-checked": "false",
      "data-slot": "toggle-group-item",
      "data-variant": "default",
      "data-size": "default",
      "data-spacing": "2",
      "id": "gi1",
      "tabindex": "-1",
      "data-radix-collection-item": "",
      "text": "A"
    },
    "activeElement": "body",
    "scrollLock": {
      "attr": null,
      "pointerEvents": ""
    }
  },
  "shadlessOpen": {
    "step": "shadless",
    "toggle-group": {
      "tag": "div",
      "data-slot": "toggle-group",
      "id": "grp",
      "dir": "ltr",
      "role": "group",
      "data-orientation": "horizontal",
      "data-spacing": "2",
      "style": "--gap:2",
      "tabindex": "0",
      "text": "AB"
    },
    "toggle-group-item": {
      "tag": "button",
      "data-slot": "toggle-group-item",
