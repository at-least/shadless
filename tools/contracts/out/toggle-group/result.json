  "oracle": {
    "click:#gi1": "on/true/0|off/false/-1|ae=gi1",
    "click:#gi1+click:#gi2": "off/false/-1|on/true/0|ae=gi2",
    "click:#gi1+click:#gi1": "off/false/0|off/false/-1|ae=gi1",
    "focus:#grp+key:ArrowRight": "off/false/-1|off/false/0|ae=gi2",
    "click:#gi1+key:ArrowRight": "on/true/-1|off/false/0|ae=gi2",
    "focus:#grp+key:ArrowRight+key:Space": "off/false/-1|on/true/0|ae=gi2",
    "focus:#grp+key:Home": "off/false/0|off/false/-1|ae=gi1",
    "focus:#grp+key:End": "off/false/-1|off/false/0|ae=gi2"
  },
  "shadless": {
    "click:#gi1": "on/true/0|off/false/-1|ae=gi1",
    "click:#gi1+click:#gi2": "off/false/-1|on/true/0|ae=gi2",
    "click:#gi1+click:#gi1": "off/false/0|off/false/-1|ae=gi1",
    "focus:#grp+key:ArrowRight": "off/false/-1|off/false/0|ae=gi2",
    "click:#gi1+key:ArrowRight": "on/true/-1|off/false/0|ae=gi2",
    "focus:#grp+key:ArrowRight+key:Space": "off/false/-1|on/true/0|ae=gi2",
    "focus:#grp+key:Home": "off/false/0|off/false/-1|ae=gi1",
    "focus:#grp+key:End": "off/false/-1|off/false/0|ae=gi2"
  },
  "pass": true
