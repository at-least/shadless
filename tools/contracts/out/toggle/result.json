{
  "oracleOpen": {
    "step": "oracle",
    "toggle": {
      "tag": "button",
      "type": "button",
      "aria-pressed": "false",
      "data-state": "off",
      "data-slot": "toggle",
      "id": "tg1",
      "text": "Bold"
    },
    "activeElement": "body",
    "scrollLock": {
      "attr": null,
      "pointerEvents": ""
    }
  },
  "shadlessOpen": {
    "step": "shadless",
    "toggle": {
      "tag": "button",
      "data-slot": "toggle",
      "id": "tg1",
      "type": "button",
      "aria-pressed": "false",
      "data-state": "off",
      "text": "Bold"
    },
    "activeElement": "body",
    "scrollLock": {
      "attr": null,
      "pointerEvents": ""
    }
  },
  "oracle": {
    "click:#tg1": "true|on",
    "focus:#tg1+key:Space": "true|on",
    "focus:#tg1+key:Enter": "true|on",
    "click:#tg1+click:#tg1": "false|off"
  },
  "shadless": {
    "click:#tg1": "true|on",
    "focus:#tg1+key:Space": "true|on",
    "focus:#tg1+key:Enter": "true|on",
    "click:#tg1+click:#tg1": "false|off"
  },
