#!/bin/sh
# shadless pre-commit hook — fast tier only (< 1s, no browser).
#
# What it does NOT do any more: guess whether a generated file was
# hand-edited. That is decided by `make reproducible` in CI (and in
# `make`), which rebuilds and byte-compares — no heuristics, no bypass
# needed for legitimate commits.
#
# Bypass (never needed for a normal commit): git commit --no-verify
say() { echo "pre-commit: $*" >&2; }

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

# retired mechanisms must not come back
for f in $STAGED; do
  case "$f" in
    patches/*)
      say "✗ REJECT — patches/ is retired. Express the change as a rule in src/, an"
      say "  authored unit under src/kernel or tools/, or a source patch in overlays/upstream/."
      exit 1 ;;
    build/*)
      say "✗ REJECT — build/ is intermediate output (gitignored)"; exit 1 ;;
  esac
done

if ! node gates/run.mjs --tier=fast >/dev/null 2>&1; then
  say "✗ REJECT — fast-tier gates failed:"
  node gates/run.mjs --tier=fast >&2 || true
  exit 1
fi
say "✓ fast tier green"
exit 0
