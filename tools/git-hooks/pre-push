#!/bin/sh
# shadless pre-push hook — medium tier (~10s: convert, emit, no browser).
say() { echo "pre-push: $*" >&2; }
if ! node gates/run.mjs --tier=medium >/dev/null 2>&1; then
  say "✗ REJECT — medium-tier gates failed:"
  node gates/run.mjs --tier=medium 2>&1 | tail -30 >&2
  exit 1
fi
say "✓ medium tier green"
exit 0
