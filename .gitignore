.upstream/
node_modules/
# every cross-node intermediate: resolved registry, oracle render harnesses,
# gate logs/reports/task packets, scratch sims. Deterministic paths (the
# gate runner is multi-process and `run <id>` reads what earlier nodes
# left here), never tracked. esbuild bundles go to node_modules/.cache.
build/
probes/scratch/

# built engine binary (make pipeline)
/build/pipeline

# Freshness bookkeeping and oracle scratch: intermediate products, not source.
# stamps/ is not tracked: a fresh clone holds the committed outputs but no
# record of which inputs produced them, so it starts cold.
/pipeline/stamps/
/tools/contracts/out/

# Zola: the rendered site (public/) and the demo tree docs-build copies into
# the served root (static/) are RENDERINGS of trees already reviewed in this
# repo (dist/, docs/demos/). The generated MARKDOWN (docs/site/content) IS
# tracked — that is the re-pin review surface: what the transform made of
# upstream's mdx. The theme (docs/site/themes/shadcn), the site shell
# (config.toml, templates/, sass/) are tracked sources too.
/docs/site/public/
/docs/site/static/

# local tooling (zcode session)
.zcode/

# codegraph index
.codegraph/
