.upstream/
node_modules/
# every cross-node intermediate: resolved registry, oracle render harnesses,
# gate logs/reports/task packets, scratch sims. Deterministic paths (the
# gate runner is multi-process and --only=<id> reads what earlier nodes
# left here), never tracked. esbuild bundles go to node_modules/.cache.
build/
probes/scratch/
# contracts: the ~7 MB oracle bundle goes to node_modules/.cache; oracle.html
# is a render harness. shadless.html + result.json stay (review surface).
tools/contracts/out/*/oracle.js
tools/contracts/out/*/.oracle-entry.mjs
tools/contracts/out/*/oracle.html

# Go pipeline runner (build artifact; pipeline/stamps.json IS tracked)
/build/pipeline

# Freshness bookkeeping and oracle scratch: intermediate products, not source.
# stamps/ was tracked so a fresh clone was warm; that trade is off now — the
# Dagger cache is content-addressed and does not live in git.
/pipeline/stamps/
/tools/contracts/out/

# The rendered docs site: 12 MB of HTML that is a RENDERING of trees already
# reviewed in this repo (dist/, docs/demos/). Tracked until 2026-08-31, when
# the mirror checks that justified it (docs-consistency §1-3) were deleted as
# tautological and the site started moving to VitePress. `reproducible` no
# longer lists it.
/docs/site/

# VitePress: the rendered site, its cache, and the demo tree docs-build copies
# into the served root. The generated MARKDOWN (docs/components, docs/guides,
# docs/index.md, docs/.vitepress/sidebar.json) IS tracked — that is the re-pin
# review surface: what the transform made of upstream's mdx.
/docs/.vitepress/dist/
/docs/.vitepress/cache/
/docs/public/
