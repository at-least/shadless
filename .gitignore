.upstream/
node_modules/
probes/out/example-golden/
probes/out/example-oracle/
probes/out/resolved-ui/
gates/out/
probes/out/example-fixture/contracts/
# esbuild oracle bundles now live in node_modules/.cache/shadless (see
# tools/oracle-lib.mjs CACHE_DIR); these patterns only keep leftovers from
# older checkouts out of the tree.
probes/out/example-fixture/bundle-*.js
probes/out/example-fixture/.entry-*
probes/out/example-fixture/.key-*
tools/contracts/out/*/oracle.js
tools/contracts/out/*/.oracle-entry.mjs
# oracle render harnesses (div#root + script tag pointing into the cache);
# the review surfaces (shadless.html, result.json, selftest-*) stay tracked
probes/out/example-fixture/oracle-*.html
tools/contracts/out/*/oracle.html
